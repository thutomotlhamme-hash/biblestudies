      "term": "Herod the king",
      "refs": [
       "Matt.2.1",
       "Matt.2.19"
      ],
      "text": "Herod I (“the Great”), king of Judaea under Rome, reigned c. 37–4 BC. His death is most commonly dated to 4 BC."
     },
     {
      "term": "Archelaus",
      "refs": [
       "Matt.2.22"
      ],
      "text": "A son of Herod. Ruled Judaea, Samaria and Idumaea as ethnarch c. 4 BC – AD 6, when Augustus removed him. This is his only appearance in Scripture."
     }
    ]
   },
